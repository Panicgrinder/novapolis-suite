#!/bin/sh
# Composite pre-commit (Python): snapshot gate + markdownlint (staged MD) + frontmatter validator.

set -eu

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
PY="$ROOT/.venv/Scripts/python.exe"
if [ ! -f "$PY" ]; then
  PY="$ROOT/.venv/bin/python"
fi
if [ ! -f "$PY" ]; then
  PY="python"
fi

"$PY" "$ROOT/scripts/pre_commit.py"
exit $?
