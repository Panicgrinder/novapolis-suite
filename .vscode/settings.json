{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.envFile": "${workspaceFolder}/.env",
  "python.testing.cwd": "${workspaceFolder}/novapolis_agent",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "python.analysis.typeCheckingMode": "standard",
  "python.terminal.activateEnvironment": true,
  "github.copilot.chat.workspaceInstructions": "Primärdokument: .github/copilot-instructions.md (SSOT). Ergänzende Navigation: novapolis-dev/docs/index.md; für RP-Datenflüsse: novapolis-rp/database-raw/99-exports/README.md. Wichtige Policy: Rohdaten bleiben in database-raw; keine ungefilterten Daten nach database-rp.",
  "github.copilot.chat.codebase": {
    "enabled": true
  },
  "task.allowAutomaticTasks": "on",
  "task.terminal.reuseOnRerun": true,
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.enabled": true,
  "remote.autoForwardPorts": true,
  "remote.autoForwardPortsSource": "hybrid",
  "extensions.autoCheckUpdates": true,
  "extensions.autoUpdate": true,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.profiles.windows": {
    "PowerShell 7": {
      "path": "C:/Program Files/PowerShell/7/pwsh.exe",
      "args": ["-NoProfile"],
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell 7",
  "terminal.integrated.automationProfile.windows": {
    "path": "C:/Program Files/PowerShell/7/pwsh.exe",
    "args": ["-NoProfile"]
  },
  "godotTools.editorPath.godot4": "${workspaceFolder}/novapolis-sim/Godot_v4.5.1-stable_win64.exe"
}
