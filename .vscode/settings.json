{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.envFile": "${workspaceFolder}/.env",
  "python.testing.cwd": "${workspaceFolder}/novapolis_agent",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "python.analysis.typeCheckingMode": "standard",
  "python.terminal.activateEnvironment": true,
  "github.copilot.chat.workspaceInstructions": ".github/copilot-instructions.md",
  "github.copilot.chat.codebase": {
    "enabled": true
  },
  "task.allowAutomaticTasks": "off",
  "task.terminal.reuseOnRerun": true,
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.enabled": true,
  "remote.autoForwardPorts": true,
  "remote.autoForwardPortsSource": "hybrid",
  "extensions.autoCheckUpdates": true,
  "extensions.autoUpdate": true,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.profiles.windows": {
    "PowerShell 7": {
      "path": "C:/Users/FloAu/AppData/Local/Microsoft/WindowsApps/pwsh.exe",
      "args": ["-NoLogo"],
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell 7",
  "terminal.integrated.automationProfile.windows": {
    "path": "C:/Users/FloAu/AppData/Local/Microsoft/WindowsApps/pwsh.exe",
    "args": ["-NoLogo"]
  },
  "powershell.powerShellAdditionalExePaths": {
    "PowerShell 7 (x64)": "C:/Users/FloAu/AppData/Local/Microsoft/WindowsApps/pwsh.exe"
  },
  "powershell.powerShellDefaultVersion": "PowerShell 7 (x64)",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.enablePersistentSessions": false,
  "godotTools.editorPath.godot4": "${env:GODOT4_PATH}",
  "python-envs.defaultEnvManager": "ms-python.python:venv"
}
