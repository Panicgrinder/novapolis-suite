{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novapolis.local/schemas/curated-manifest.schema.json",
  "title": "Curated Staging Manifest",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "source": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "enum": ["raw-txt", "raw-jsonl", "raw-pdf", "curated-merge"] },
      "status": { "type": "string", "enum": ["pending", "in-progress", "reviewed", "approved", "archived"] },
      "createdAt": { "type": "string" },
      "artifacts": {
        "type": "object",
        "properties": {
          "normalized": { "type": "string" },
          "chunksDir": { "type": "string" },
          "index": { "type": "string" },
          "reports": { "type": "object", "additionalProperties": { "type": "string" } },
          "review": { "type": "string" },
          "views": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": true
      },
      "reviewed": {
        "type": "object",
        "properties": {
          "dir": { "type": "string" },
          "indexReview": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
            },
            "required": ["path"],
            "additionalProperties": true
          },
          "lexicon": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
            },
            "required": ["path"],
            "additionalProperties": true
          },
          "unresolved": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
            },
            "required": ["path"],
            "additionalProperties": true
          },
          "parts": {
            "type": "object",
            "properties": {
              "pattern": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "promotion": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "finalGate": {
            "type": "object",
            "properties": {
              "criteria": { "type": "array", "items": { "type": "string" } },
              "blocked": { "type": "boolean" },
              "blockedReasons": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "runs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "minLength": 1 },
            "at": { "type": "string", "minLength": 1 },
            "tool": { "type": "object", "additionalProperties": true },
            "outputs": { "type": "object", "additionalProperties": true }
          },
          "required": ["id", "type", "at"],
          "additionalProperties": true
        }
      },
      "notes": { "type": "string" }
    },
    "required": ["id", "source", "type", "status", "createdAt"],
    "additionalProperties": true
  }
}
